# Local Development (SQLite)
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL)
# DATABASE_URL="postgresql://user:password@localhost:5432/gizmo?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-32-byte-secret"

# Invite-Only Account Admission (Required - fails closed if omitted)
ACCOUNT_ADMISSION_MODE="invitation-only"
INVITATION_TTL_HOURS="168"

# CLI-Only Bootstrap Admin Credentials (used only by `npm run bootstrap:admin`)
BOOTSTRAP_ADMIN_EMAIL="admin@gizmo.local"
BOOTSTRAP_ADMIN_PASSWORD="AdminPassword123!"
BOOTSTRAP_ADMIN_NAME="Jack Huang (Admin)"
